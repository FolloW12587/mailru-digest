<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Шаблон launchd-агента для macOS.
  Замените YOUR_USERNAME на имя вашего пользователя и путь к python3,
  затем скопируйте в ~/Library/LaunchAgents/
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.mailru-digest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/YOUR_USERNAME/mailru-digest/digest.py</string>
    </array>

    <!-- Время ежедневного запуска -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/mailru-digest/digest.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/mailru-digest/digest.log</string>
</dict>
</plist>
