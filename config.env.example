# Скопируйте этот файл в config.env и заполните значения:
#   cp config.env.example config.env && chmod 600 config.env

# Почта mail.ru
MAIL_USER=ваш_адрес@mail.ru
# ВАЖНО: не основной пароль от ящика, а "пароль для внешнего приложения"
# Создаётся здесь: https://id.mail.ru/security
MAIL_PASSWORD=

# Telegram: токен от @BotFather и ваш chat_id от @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Сколько писем максимум показывать в дайджесте
MAX_MESSAGES=40
# Присылать сообщение, даже если непрочитанных нет (подтверждает, что скрипт жив)
SEND_IF_EMPTY=true
